# Copy to .env and fill in real values. .env is git-ignored and must never be committed
# (SAD section 15, Database Design & ERD Specification section 28, SRS section 9).

# ---- Database ---------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/pos_db
DATABASE_USERNAME=postgres
# Required. The application will not start without it.
DATABASE_PASSWORD=

# Consumed by docker-compose when provisioning the local PostgreSQL container.
POSTGRES_DB=pos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- API --------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=default
# Comma-separated browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to false in production so OpenAPI and Swagger UI are not published.
SPRINGDOC_ENABLED=true

# ---- Authentication ---------------------------------------------------------
# Required. The application refuses to start without both, and each must be at
# least 32 characters. Nothing signs a token yet — the check exists so a weak or
# missing secret cannot reach the authentication work in Phase 1.
# Generate each one separately, for example:
#   openssl rand -hex 32
# Never reuse a value across environments and never commit a real value.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- First-administrator provisioning ---------------------------------------
# Runs ONCE, only when explicitly enabled, and is permanently one-shot afterwards:
# the database records completion, so deleting the administrator does NOT let a
# restart recreate it. See docs/adr/ADR-015-first-administrator-provisioning.md.
#
# Leave disabled unless you are provisioning a brand-new deployment.
APP_BOOTSTRAP_ENABLED=false
# All four are required when enabled, and have no defaults: the account holds every
# identity permission and must be a named person, not a generic "admin".
APP_BOOTSTRAP_USERNAME=
APP_BOOTSTRAP_FIRST_NAME=
APP_BOOTSTRAP_LAST_NAME=
APP_BOOTSTRAP_EMAIL=
# Supply the password by ONE of these. The file is preferred in production: an
# environment variable is readable via `docker inspect`, /proc/<pid>/environ and
# crash dumps. Minimum 12 characters.
APP_BOOTSTRAP_PASSWORD_FILE=
APP_BOOTSTRAP_PASSWORD=
#
# After the first successful start: remove these values and rotate the credential.
# The administrator is created requiring a password change on first use, so the
# supplied password stops working as soon as it is rotated.
